<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <!-- ========== 计时方式 ========== -->
        <TextView style="@style/SettingHeader" android:layout_marginTop="4dp" android:text="计时方式" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="正常计时" />

            <RadioButton
                android:id="@+id/rbDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="倒计时" />

            <RadioButton
                android:id="@+id/rbStages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="多段计时" />
        </RadioGroup>

        <!-- ========== 倒计时 ========== -->
        <LinearLayout
            android:id="@+id/sectionCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SettingHeader" android:text="倒计时时间" />

            <RadioGroup
                android:id="@+id/rgPreset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="3分钟" />

                <RadioButton
                    android:id="@+id/rb5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="5分钟" />

                <RadioButton
                    android:id="@+id/rb10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="10分钟" />

                <RadioButton
                    android:id="@+id/rbCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自定义" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/rowCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <NumberPicker
                    android:id="@+id/npH"
                    android:layout_width="wrap_content"
                    android:layout_height="120dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    android:text="时" />

                <NumberPicker
                    android:id="@+id/npM"
                    android:layout_width="wrap_content"
                    android:layout_height="120dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    android:text="分" />

                <NumberPicker
                    android:id="@+id/npS"
                    android:layout_width="wrap_content"
                    android:layout_height="120dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="秒" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="结束前提示音"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/spCdRemind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========== 多段计时 ========== -->
        <LinearLayout
            android:id="@+id/sectionStages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SettingHeader" android:text="多段计时（如：答辩 10 分钟 → 提问 5 分钟）" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:text="每段结束响一次铃；“提示音”是该段结束前的短促“嘀嘀嘀”提醒。最后一段结束响结束铃。"
                android:textSize="12sp" />

            <include android:id="@+id/stage1" layout="@layout/item_stage" />
            <include android:id="@+id/stage2" layout="@layout/item_stage" />
            <include android:id="@+id/stage3" layout="@layout/item_stage" />

            <Switch
                android:id="@+id/swAutoNext"
                style="@style/SettingSwitch"
                android:layout_marginTop="6dp"
                android:text="上一段结束后自动开始下一段" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:text="关闭后：上一段结束时继续显示超时，需点“开始下一段”。计时中也可随时点右下角“下一段”提前切换。"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="段间铃声时长"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/spStageBell"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnTemplate"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="恢复答辩模板（10 分钟 + 5 分钟）" />
        </LinearLayout>

        <!-- ========== 倒计时 / 多段共用 ========== -->
        <LinearLayout
            android:id="@+id/sectionDownOpts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Switch
                android:id="@+id/swOvertime"
                style="@style/SettingSwitch"
                android:text="时间到后继续显示超时时间" />

            <Switch
                android:id="@+id/swWarn"
                style="@style/SettingSwitch"
                android:text="最后 1 分钟数字变为橙色" />
        </LinearLayout>

        <!-- ========== 铃声与提醒 ========== -->
        <TextView style="@style/SettingHeader" android:text="铃声与提醒" />

        <Switch
            android:id="@+id/swRing"
            style="@style/SettingSwitch"
            android:text="时间到时响铃" />

        <LinearLayout
            android:id="@+id/sectionRing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRingName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSysRing"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选系统铃声" />

                <Button
                    android:id="@+id/btnFileRing"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选本地音频" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="结束铃声时长"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/spDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/sbVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:max="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:text="铃声和提示音共用此音量；实际音量 = 系统“闹钟音量” × 此比例"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPreview"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="试听铃声" />

            <Button
                android:id="@+id/btnPreviewBeep"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="试听提示音" />
        </LinearLayout>

        <Switch
            android:id="@+id/swVibrate"
            style="@style/SettingSwitch"
            android:text="同时振动" />

        <!-- ========== 显示与操作 ========== -->
        <TextView style="@style/SettingHeader" android:text="显示与操作" />

        <Switch
            android:id="@+id/swTapPause"
            style="@style/SettingSwitch"
            android:text="轻触计时数字可暂停 / 继续" />

        <Switch
            android:id="@+id/sw24"
            style="@style/SettingSwitch"
            android:text="24 小时制" />

        <Switch
            android:id="@+id/swKeepScreen"
            style="@style/SettingSwitch"
            android:text="屏幕常亮（本应用在前台时不自动息屏）" />

        <Switch
            android:id="@+id/swFullscreen"
            style="@style/SettingSwitch"
            android:text="全屏（隐藏状态栏和导航栏）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="屏幕方向"
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/rgOrient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbLand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="横屏" />

            <RadioButton
                android:id="@+id/rbPort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="竖屏" />

            <RadioButton
                android:id="@+id/rbAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="跟随系统" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="主界面左上角提示语（可留空）"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etMotto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：2026 届本科毕业答辩"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="40" />
    </LinearLayout>
</ScrollView>
